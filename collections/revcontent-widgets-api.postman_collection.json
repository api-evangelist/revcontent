            "description": {
              "content": "Get list of sub id statistic csv's for a specific widget. The stats are not realtime and are behind by an hour.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "stats",
                "api",
                "v1.0",
                "widgets",
                ":widget_id",
                "revsub"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "date",
                  "value": "<string>",
                  "description": "(Required) Date of statistics in Y-m-d format (EST timezone)."
                },
                {
                  "disabled": false,
                  "key": "hour",
                  "value": "Returns stats for all available hours of the date",
                  "description": "Get stats for a specific hour. Should be in 24-hour format and between 00-23 (EST timezone). For ex: \"hour=01\""
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<number>",
