          "request": {
            "name": "Get All Widgets",
            "description": {
              "content": "Get list of widgets",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "stats",
                "api",
                "v1.0",
                "widgets"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "widget",
                  "value": "<number>",
                  "description": "Filter stats by a specific widget. For example \"1234\". Defaults to all widgets."
                },
                {
                  "disabled": false,
                  "key": "domain",
                  "value": "<string>",
                  "description": "Filter widgets by a specific domain. For example \"revcontent.com\". Defaults to all domains."
                },
                {
                  "disabled": false,
                  "key": "device",
                  "value": "<string>",
                  "description": "Filter stats by a specific device. Values: \"all\", \"desktop\", \"tablet\", \"mobile\", \"unknown\". Defaults to all."
                },
                {
                  "disabled": false,
                  "key": "date_from",
                  "value": "first of the month",
                  "description": "Start date for the statistics in Y-m-d format. Defaults to first of the current month."
                },
                {
                  "disabled": false,
                  "key": "date_to",
                  "value": "today's date",
                  "description": "End date for the statistics in Y-m-d format. Defaults to today."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "100",
                  "description": "Number of records to return. Max 100."
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0",
                  "description": "Offset for the records to return."
                },
                {
                  "disabled": false,
                  "key": "aggregate",
                  "value": "no",
                  "description": "If 'yes', statistics aggregated by date are retrieved."
                }
