{
  "opencollection": "1.0.0",
  "info": {
    "name": "RevContent Sub Accounts API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
